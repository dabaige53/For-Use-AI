flowchart TB
    START["目标：与 AI 合作，把自己的材料做成课件"]

    subgraph L1["第一条线｜地形与教学对话：通过 HTML 原型样例驱动"]
        direction TB
        T1["收集地形相关原始文章"]
        T2["梳理文章表达与图形的映射<br/>明确映射标准"]
        T3["整理原型设计 skills<br/>设计小球、运动轨迹等参数"]
        T4["产出 HTML 原型样例"]
        T5["构建 3D 地形图"]
        T6["操作原型并对照文章<br/>逐步调整表达、画面和运动参数"]
        T7["形成地形图与教学内容<br/>交付可运行的 HTML 地形演示"]

        T1 --> T2 --> T3 --> T4 --> T5 --> T6 --> T7
        T6 -.反馈修改.-> T4
    end

    subgraph L2["第二条线｜视频制作：还原最佳实践，沉淀 skills，再制作自己的视频"]
        direction TB
        V1["寻找最佳实践<br/>找到 3Blue1Brown 的视频"]
        V2["从官网获取<br/>技术架构与相关源码"]
        V3["在本地还原视频内容"]
        V4["提炼制作要求与实现细节"]
        V5["整理成 3 个 skills<br/>用于后续工作直接调用"]
        S1["explanatory-article<br/>解释型文章"]
        S2["manim-animation<br/>动画制作"]
        S3["manim-video<br/>完整视频制作"]
        V6["收集关于输入输出的素材与文章"]
        V7["使用 skills 整理成解释型文章"]
        V8["根据文章内容与表达方式<br/>确定镜头安排和数量"]
        V9["逐步生成分镜图片"]
        V10["逐步完成视频开发"]
        V11["完成视频"]

        V1 --> V2 --> V3 --> V4 --> V5
        V5 --> S1
        V5 --> S2
        V5 --> S3
        V6 --> V7 --> V8 --> V9 --> V10 --> V11
        S1 -.指导文章整理.-> V7
        S2 -.指导动画实现.-> V10
        S3 -.指导分镜与整片制作.-> V8
        S3 -.指导整片制作.-> V10
    end

    subgraph L3["第三条线｜课程网页：多条内容线与网站开发交织"]
        direction TB

        W1["收集其他课程原始文章"]
        W2["按 explanatory-article 要求<br/>整理为课程文章"]

        Q1["以前关于四象限的思考<br/>与现成文章"]
        Q2["按 explanatory-article 要求<br/>改写四象限文章"]
        Q3["形成四象限内容与图形表达"]

        G1["按 explanatory-article 要求<br/>整理地形相关文章"]
        G2["结合地形文章与 HTML 演示"]

        W3["参考样例网站<br/>ce101.ifuryst.com"]
        W4["结合原始文章、skills 要求与样例网站<br/>完成整体模仿和开发"]
        W5["接入各篇文章、图形与交互演示"]
        W6["查看实际网页<br/>回顾内容、结构和呈现效果"]
        W7["形成整套课程网站"]

        W1 --> W2
        Q1 --> Q2 --> Q3
        G1 --> G2
        W3 --> W4 --> W5 --> W6 --> W7

        W2 --> W4
        W2 --> W5
        Q3 --> W5
        G2 --> W5

        W6 -.调整文章.-> W2
        W6 -.调整四象限表达.-> Q3
        W6 -.调整内容与演示配合.-> G2
        W6 -.调整网站实现.-> W4
    end

    subgraph L4["第四条线｜现场 PPT：确定设计，接入内容，完善演讲"]
        direction TB

        P1["① 确认演讲要求与细节"]
        P2["根据网页内文章<br/>确定整体大纲"]
        P3["根据大纲与相关文字<br/>生成 PPT 样式图片"]
        P4["查看并确认 PPT UI 效果"]
        P5["将选定图片嵌入 PPT<br/>作为定稿页面"]

        P6["② 确认视频与地形图<br/>在 PPT 中的嵌入原型效果"]
        P7["嵌入视频与地形图内容"]

        P8["③ 确认四象限<br/>在 PPT 中的嵌入效果"]
        P9["嵌入四象限内容"]

        P10["④ 汇合为整套课件<br/>回顾整体内容，发现不足"]
        P11["优化内容、页面与演示效果"]
        P12["⑤ 生成演讲稿<br/>细化讲述、页面衔接和演示安排"]
        P13["完整交付<br/>PPT＋嵌入内容＋演讲稿与演讲细节"]

        P1 --> P2 --> P3 --> P4 --> P5
        P4 -.调整样式图片.-> P3

        P5 --> P6 --> P7
        P5 --> P8 --> P9
        P7 --> P10
        P9 --> P10
        P10 --> P11 --> P12 --> P13

        P11 -.优化大纲与内容.-> P2
        P11 -.优化页面效果.-> P3
        P11 -.优化视频与地形嵌入.-> P6
        P11 -.优化四象限嵌入.-> P8
    end

    START --> T1
    START --> V1
    START --> V6
    START --> W1
    START --> Q1
    START --> W3
    START --> P1

    S1 -.提供文章整理要求.-> W2
    S1 -.提供文章整理要求.-> Q2
    S1 -.提供文章整理要求.-> G1

    T1 -.原始文章进入课程内容线.-> G1
    T7 -.提供可运行演示.-> G2
    V7 -.输入输出文章进入课程网站.-> W5

    W7 -.提供文章与内容依据.-> P2
    V11 -.提供完成的视频.-> P6
    T7 -.提供 HTML 地形演示.-> P6
    Q3 -.提供四象限内容.-> P8

    P11 -.需要修改地形演示时返回.-> T6
    P11 -.需要修改视频时返回.-> V10

