flowchart TB
    START["目标：与 AI 合作，把自己的材料做成课件"]

    subgraph L1["第一条线｜地形与教学对话：通过 HTML 原型样例驱动"]
        direction TB
        T1["收集地形相关原始文章"]
        T2["梳理文章表达与图形的映射<br/>设计小球、运动轨迹等参数"]
        T4["产出 HTML 原型样例<br/>构建 3D 地形图"]
        T6["操作原型并对照文章<br/>↺ 不对就回到原型修改"]
        T7["交付可运行的 HTML 地形演示"]

        T1 --> T2 --> T4 --> T6 --> T7
    end

    subgraph L2["第二条线｜视频制作：还原最佳实践，沉淀 skills，再制作自己的视频"]
        direction TB
        V1["寻找最佳实践<br/>找到 3Blue1Brown 的视频"]
        V3["获取技术架构与源码<br/>在本地还原视频内容"]
        V5["提炼制作要求与实现细节"]
        S1["沉淀 3 个 skills<br/>解释型文章 · 动画 · 完整视频"]
        V7["用 skills 把输入输出素材<br/>整理成解释型文章"]
        V8["确定镜头安排<br/>逐步生成分镜图片"]
        V10["逐步完成视频开发"]
        V11["完成视频"]

        V1 --> V3 --> V5 --> S1 --> V7 --> V8 --> V10 --> V11
    end

    subgraph L3["第三条线｜课程网页：多条内容线与网站开发交织"]
        direction TB
        W2["按 explanatory-article 要求<br/>整理课程、四象限与地形文章"]
        Q3["形成四象限内容与图形表达"]
        W3["参考样例网站<br/>ce101.ifuryst.com"]
        W4["结合文章与样例网站<br/>完成整体模仿和开发"]
        W5["接入各篇文章、图形与交互演示"]
        W6["查看实际网页<br/>↺ 回到文章与实现调整"]
        W7["形成整套课程网站"]

        W2 --> Q3
        W2 --> W4
        W3 --> W4 --> W5 --> W6 --> W7
        Q3 --> W5
    end

    subgraph L4["第四条线｜现场 PPT：确定设计，接入内容，完善演讲"]
        direction TB
        P2["① 确认演讲要求<br/>根据网站文章确定大纲"]
        P4["生成 PPT 样式图片<br/>↺ 查看并确认 UI 效果"]
        P5["将选定图片嵌入 PPT<br/>作为定稿页面"]
        P7["② 确认并嵌入<br/>视频与地形图"]
        P9["③ 确认并嵌入<br/>四象限内容"]
        P10["④ 汇合为整套课件<br/>↺ 回顾不足并优化"]
        P12["⑤ 生成演讲稿<br/>细化讲述、页面衔接和演示安排"]
        P13["完整交付<br/>PPT＋嵌入内容＋演讲稿与演讲细节"]

        P2 --> P4 --> P5
        P5 --> P7 --> P10
        P5 --> P9 --> P10
        P10 --> P12 --> P13
